# Normalize text files and keep working-tree line endings platform-native.
* text=auto

# Source and configuration files use LF in the repository.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.target.cs text eol=lf
*.build.cs text eol=lf

# Unreal Engine assets and other large binary files managed by Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
